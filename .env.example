# --- Server ---
NODE_ENV=development
PORT=4000
# Forums are served at <subdomain>.<BASE_DOMAIN> (e.g. demo.localhost)
BASE_DOMAIN=localhost
CLIENT_ORIGIN=http://localhost:5173

# --- PostgreSQL ---
POSTGRES_USER=forum
POSTGRES_PASSWORD=change-me
POSTGRES_DB=forum_builder
DATABASE_URL=postgres://forum:change-me@localhost:5432/forum_builder

# --- Auth (JWT) ---
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# --- Integrations (later stages) ---
OPENAI_API_KEY=
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
